# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용. 절대 클라이언트에 노출 금지 (NEXT_PUBLIC_ 접두사 X)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend ────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# 인증된 도메인의 발신 주소 (예: news@yourdomain.com)
RESEND_FROM=Marketing Weekly <onboarding@resend.dev>

# ── Cron 보안 ─────────────────────────────────────────────
# /api/cron/dispatch 호출을 보호하는 임의의 긴 문자열
CRON_SECRET=change-me-to-a-long-random-string

# ── (선택) 발송 시 절대 URL이 필요할 때 ─────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
